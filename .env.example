# Скопируйте этот файл под именем .env и заполните значения

# Токен бота от @BotFather (без кавычек)
BOT_TOKEN=

# Telegram-ID админов через запятую (узнать свой ID можно у бота @userinfobot)
ADMIN_IDS=

# Какое значение status считается «действие подтверждено» (обычно 1)
STATUS_OK=1

# Порт HTTP-сервера, на который приходит postback (по умолчанию 8000)
POSTBACK_PORT=8000

# Секретное слово в postback для защиты от подделки (можно оставить пустым)
# Если заполнено, партнёрка должна присылать: ...&secret=это_слово
POSTBACK_SECRET=